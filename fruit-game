<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MSP Product Catcher Game</title>
<style>
* {
  box-sizing:border-box;
}body {
  margin:0;
  padding:10px;
  text-align:center;
  font-family:sans-serif;
  background:linear-gradient(#fd6fde,#f96d7b);
}#gameArea {
  position:relative;
  width:min(95vw,400px);
  margin:10px auto;
  overflow:hidden;
  border-radius:16px;
}canvas {
  display:block;
  width:100%;
  height:auto;
  background:linear-gradient(#a5e6ff,#e6ffd1);
  border:4px solid white;
  border-radius:16px;
  touch-action:none;
}#startScreen {
  position:absolute;
  inset:0;
  z-index:5;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:flex-start;
  padding:10px 12px 14px;
  background:linear-gradient(180deg,#a9e8ff,#eaffd5);
  border-radius:12px;
  overflow-y:auto;
  gap:4px;
}#startScreen h2 {
  color:#ed792d;
  margin:5px;
  font-size:21px;
  text-shadow:0 1px #fff;
}#startScreen p {
  font-size:12px;
  margin:5px;
}.previewStats {
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:5px;
  margin:3px;
}.previewStats div,#gameStats div {
  background:#fffffff0;
  padding:7px 10px;
  border-radius:12px;
  font-size:12px;
  font-weight:bold;
}.howToPlay {
  width:100%;
  max-width:340px;
  margin:6px auto;
  padding:8px;
  background:#ffffff99;
  border-radius:14px;
  text-align:left;
}.howToPlay h3 {
  color:#ed792d;
  text-align:center;
  margin:3px;
}.howToPlay p {
  margin:4px 0!important;
}
.previewProductCounts,
.liveProductCounts {
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:4px;
}
.countBadge {
  display:inline-flex;
  align-items:center;
  gap:3px;
  padding:4px 7px;
  border-radius:9px;
  background:#fffffff0;
  color:#284d36;
  font-size:10px;
  line-height:1.25;
}
#gameStats .liveProductCounts {
  background:transparent;
  padding:0;
  border-radius:0;
  font-size:inherit;
}
#gameStats .countBadge {
  padding:4px 6px;
  font-size:10px;
}
.howToProducts {
  display:flex;
  flex-direction:column;
  gap:4px;
  margin:6px 0;
}
.howToProduct {
  display:flex;
  align-items:center;
  gap:8px;
  min-height:39px;
  padding:3px 7px;
  background:#ffffffb8;
  border-radius:9px;
}
.howToProduct img {
  width:34px;
  height:38px;
  flex:0 0 34px;
  object-fit:contain;
  display:block;
}
.howToProduct .productName {
  flex:1;
  min-width:0;
  font-size:12px;
  line-height:1.2;
}
.howToProduct .productPoints {
  flex:0 0 auto;
  color:#b54b16;
  font-size:11px;
  font-weight:bold;
  white-space:nowrap;
}
button {
  background:#ff8c42;
  border:none;
  color:white;
  padding:10px 15px;
  border-radius:22px;
  font-size:14px;
  font-weight:bold;
  cursor:pointer;
  margin:3px;
}button:active {
  transform:scale(.95);
}.sound {
  background:#78b9ff;
}#gameStats {
  display:none;
  position:absolute;
  top:10px;
  left:7px;
  right:7px;
  z-index:3;
  justify-content:center;
  align-items:center;
  flex-wrap:wrap;
  gap:4px;
  pointer-events:none;
}#gameStats div {
  padding:4px 6px;
  font-size:10px;
}
#gameStats .liveProductTracker {
  width:100%;
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:4px;
  padding:0;
  margin:0 2px;
  background:transparent;
  pointer-events:none;
}
.liveTrackerItem {
  min-width:0;
  min-height:43px;
  display:flex;
  align-items:center;
  justify-content:flex-start;
  gap:4px;
  padding:3px 4px;
  border:1px solid #d8e8df;
  border-radius:8px;
  background:#fffffff2;
  color:#284d36;
  box-shadow:0 1px 3px #00000018;
}
.liveTrackerItem.collected {
  border:2px solid #2aa66a;
  background:#e9fff1;
}
.liveTrackerItem img {
  width:23px;
  height:30px;
  flex:0 0 23px;
  object-fit:contain;
}
.liveTrackerText {
  min-width:0;
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  gap:1px;
  line-height:1.05;
}
.liveTrackerName {
  width:100%;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  font-size:8px;
  font-weight:700;
}
.liveTrackerCount {
  font-size:10px;
  font-weight:800;
  color:#b54b16;
}
.liveTrackerItem.collected .liveTrackerCount {
  color:#16834d;
}
#pauseBtn {
  pointer-events:auto;
  background:#ff9800;
  padding:7px 12px;
  font-size:12px;
}#pauseScreen {
  display:none;
  position:absolute;
  inset:0;
  z-index:8;
  background:#1e2d37b3;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  color:white;
}#result {
  display:none;
  position:fixed;
  z-index:1000;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  width:min(92vw, 420px);
  max-height:calc(100vh - 28px);
  max-height:calc(100dvh - 28px);
  overflow-y:auto;
  overscroll-behavior:contain;
  -webkit-overflow-scrolling:touch;
  background:#fffffff7;
  border:4px solid #ffb347;
  border-radius:22px;
  padding:12px 14px;
  box-shadow:0 8px 25px #5557;
  text-align:center;
}
#result h2 {
  line-height:1.2;
  font-size:clamp(18px, 4.5vw, 23px);
}
#result button {
  margin:8px auto 2px;
}
@media (max-height:650px) {
  #result {
    padding:8px 12px;
    border-radius:16px;
  }
  #result h2 {
    margin:3px;
    font-size:18px;
  }
  #result .percent {
    font-size:25px !important;
    margin:5px !important;
  }
  #result .progressTrack {
    margin:5px 0;
  }
}#result h2 {
  color:#e65d35;
  margin:5px;
}#result p {
  margin:4px;
}.percent {
  font-size:30px!important;
  color:#15965b;
  font-weight:bold;
  margin:8px!important;
}.progressTrack {
  height:13px;
  background:#ddd;
  border-radius:20px;
  overflow:hidden;
  margin:8px 0;
}.progressFill {
  height:100%;
  background:linear-gradient(90deg,#55c878,#15965b);
  width:0%;
  border-radius:20px;
}
</style>
</head>
<body>

<div id="gameArea">
  <canvas id="game" width="400" height="550"></canvas>

  <div id="gameStats">
    <div>🏆 คะแนน: <span id="liveScore">0</span></div>
    <div>📊 <span id="livePercent">0</span>%</div>
    <div>💣 ระเบิด: <span id="liveBombs">0</span>/3</div>
    <div id="liveProductTracker" class="liveProductTracker" aria-label="รายการสินค้าที่เก็บได้"></div>
    <button id="pauseBtn" onclick="togglePause()">⏸ หยุดเกม</button>
  </div>

  <div id="startScreen">
    <h2>🛍️ MSP Product Catcher</h2>
    <p>เก็บกล่องสินค้า MSP ให้ได้เยอะ ๆ ระวังระเบิดนะ!</p>

    <div class="previewStats">
      <div>🏆 คะแนน: <span id="previewScore">0</span></div>
      <div>🎯 เป้าหมาย: 3500 คะแนน</div>
      <div>📊 <span id="previewPercent">0</span>%</div>
    </div>

    <div class="previewStats">
      <div>💣 ระเบิด: <span id="previewBombs">0</span>/3</div>
    </div>

    <div class="howToPlay">
      <h3>📖 วิธีเล่น</h3>
      <p>🧺 เก็บกล่องสินค้าเพื่อสะสมคะแนน</p>
      <div id="howToProducts" class="howToProducts" aria-label="รายการสินค้าและคะแนน"></div>
      <p>🎯 เป้าหมาย 3500 คะแนน = 100%</p>
      <p>💣 ระเบิดครบ 3 ครั้ง เกมจะจบ</p>
      <p>⏸ กดหยุดเกมเพื่อพักได้</p>
    </div>

    <button onclick="startGame()">▶ เริ่มเกม</button>
    <button class="sound" id="soundBtn" onclick="toggleSound()">🔊 ปิดเสียง</button>
    <p>👆 ใช้นิ้วลากตะกร้าไปทางซ้ายและขวา เพื่อเก็บสินค้า</p>
  </div>

  <div id="pauseScreen">
    <h2>⏸ หยุดเกม</h2>
    <p>พักสักครู่ แล้วค่อยลุยต่อ!</p>
    <button onclick="togglePause()" style="background:#36a66b">▶ เล่นต่อ</button>
  </div>

  <div id="result"></div>
</div>

<script>
"use strict";

const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

const gameStats = document.getElementById("gameStats");
const startScreen = document.getElementById("startScreen");
const pauseScreen = document.getElementById("pauseScreen");
const resultScreen = document.getElementById("result");
const pauseBtn = document.getElementById("pauseBtn");
const soundBtn = document.getElementById("soundBtn");

const TARGET_SCORE = 3500;

let basket, items = [];
let score = 0;
let bombs = 0;
let productCounts = Array(7).fill(0);

let playing = false;
let isPaused = false;
let animation = null;
let spawnTimer = 0;
let lastTime = 0;

let audioContext = null;
let musicTimer = null;
let musicOn = true;
let musicStep = 0;

const products = [
  {
    name: "Apple Cider Vinegar",
    thai: "แอปเปิลไซเดอร์",
    points: 50,
    image: "data:image/webp;base64,"
  },
  {
    name: "Olive Oil Plus",
    thai: "น้ำมันมะกอก",
    points: 50,
    image: "data:image/webp;base64,"
  },
  {
    name: "Garlic Oil Plus",
    thai: "น้ำมันกระเทียม",
    points: 50,
    image: "data:image/webp;base64,"
  },
  {
    name: "Magnesium Complex",
    thai: "แมกนีเซียมคอมเพล็กซ์",
    points: 50,
    image: "data:image/webp;base64,"
  },
  {
    name: "Astaxanthin",
    thai: "แอสต้าแซนธิน",
    points: 50,
    image: "data:image/webp;base64,"
  },
  {
    name: "Collagen 3 Plus CoQ10 Lycopene",
    thai: "คอลลาเจน 3 พลัส CoQ10 ไลโคปีน",
    points: 50,
    image: "data:image/webp;base64,"
  },
  {
    name: "Undenatured Collagen Type II Plus",
    thai: "อันดิเนเจอร์ คอลลาเจน ไทพ์ทู พลัส",
    points: 50,
    image: "data:image/webp;base64,"
  }
];;
const productImages = products.map((product) => {
  const image = new Image();
  image.src = product.image;
  return image;
});

// ซ่อนแถบตัวนับจำนวนสินค้าระหว่างเล่นและบนหน้าปก


// แสดงภาพสินค้าขนาดเล็กในกรอบวิธีเล่น
const howToProducts = document.getElementById("howToProducts");
howToProducts.innerHTML = products.map((product) => `
  <div class="howToProduct">
    <img src="${product.image}" alt="${product.name}">
    <span class="productName">${product.name}</span>
    <span class="productPoints">${product.points} คะแนน</span>
  </div>
`).join("");

const bombItem = {type:"bomb",points:0};

// คำนวณเปอร์เซ็นต์จากเป้าหมาย 3500 คะแนน
function getPercent() {
  return Math.min(100, Math.round(score / TARGET_SCORE * 100));
}

// ===== ระบบเสียง =====

function initAudio() {
  const AudioCtx = window.AudioContext || window.webkitAudioContext;
  if (!AudioCtx) return;

  if (!audioContext) audioContext = new AudioCtx();

  if (audioContext.state === "suspended") {
    audioContext.resume().catch(() => {});
  }
}

function playTone(freq,duration,type="sine",volume=0.08) {
  if (!audioContext || !musicOn || isPaused) return;

  const osc = audioContext.createOscillator();
  const gain = audioContext.createGain();
  const now = audioContext.currentTime;

  osc.type = type;
  osc.frequency.value = freq;

  gain.gain.setValueAtTime(volume,now);
  gain.gain.exponentialRampToValueAtTime(0.001,now+duration);

  osc.connect(gain);
  gain.connect(audioContext.destination);

  osc.start(now);
  osc.stop(now+duration);
}

const melody = [
  523,659,784,659,
  587,698,880,698,
  523,659,784,1047,
  880,784,659,523
];

function playMusic() {
  stopMusic();
  if (!musicOn || !playing || isPaused) return;

  musicTimer = setInterval(() => {
    if (!playing || isPaused || !musicOn) return;
    playTone(melody[musicStep % melody.length],0.22);
    musicStep++;
  },280);
}

function stopMusic() {
  if (musicTimer !== null) {
    clearInterval(musicTimer);
    musicTimer = null;
  }
}

function toggleSound() {
  musicOn = !musicOn;
  soundBtn.textContent = musicOn ? "🔊 ปิดเสียง" : "🔇 เปิดเสียง";

  if (musicOn) {
    initAudio();
    if (playing && !isPaused) playMusic();
  } else {
    stopMusic();
  }
}

function fruitSound() {
  playTone(880,0.12);
  setTimeout(() => playTone(1100,0.12),90);
}

function bombSound() {
  playTone(100,0.35,"sawtooth",0.15);
}

function gameOverSound() {
  if (!audioContext || !musicOn) return;

  const notes = [
    {freq:523,time:0,duration:0.2},
    {freq:392,time:0.2,duration:0.2},
    {freq:330,time:0.4,duration:0.25},
    {freq:220,time:0.7,duration:0.6}
  ];

  notes.forEach(note => {
    const osc = audioContext.createOscillator();
    const gain = audioContext.createGain();
    const start = audioContext.currentTime + note.time;

    osc.type = "triangle";
    osc.frequency.value = note.freq;

    gain.gain.setValueAtTime(0.12,start);
    gain.gain.exponentialRampToValueAtTime(0.001,start+note.duration);

    osc.connect(gain);
    gain.connect(audioContext.destination);

    osc.start(start);
    osc.stop(start+note.duration);
  });
}

// ===== คะแนนและสถิติ =====

function updateStats() {
  const percent = getPercent();

  document.getElementById("previewScore").textContent = score;
  document.getElementById("previewPercent").textContent = percent;
  document.getElementById("previewBombs").textContent = bombs;
  document.getElementById("liveScore").textContent = score;
  document.getElementById("livePercent").textContent = percent;
  document.getElementById("liveBombs").textContent = bombs;

  const tracker = document.getElementById("liveProductTracker");
  if (tracker) {
    tracker.innerHTML = products.map((product, index) => {
      const count = productCounts[index] || 0;
      const collectedClass = count > 0 ? " collected" : "";
      return `
        <div class="liveTrackerItem${collectedClass}" title="${product.thai}: ${count} ชิ้น">
          <img src="${product.image}" alt="">
          <span class="liveTrackerText">
            <span class="liveTrackerName">${product.thai}</span>
            <span class="liveTrackerCount">${count} ชิ้น</span>
          </span>
        </div>
      `;
    }).join("");
  }
}

function updatePauseButton() {
  pauseBtn.textContent = isPaused ? "▶ เล่นต่อ" : "⏸ หยุดเกม";
  pauseBtn.style.background = isPaused ? "#36a66b" : "#ff9800";
}

function resetGame() {
  basket = {x:160,y:490,w:80,h:35};
  items = [];

  score = 0;
  bombs = 0;
  productCounts = Array(products.length).fill(0);

  spawnTimer = 0;
  lastTime = 0;
  musicStep = 0;
  isPaused = false;

  updateStats();
  updatePauseButton();
}

// ===== หยุดและเล่นต่อ =====

function togglePause() {
  if (!playing) return;

  isPaused = !isPaused;
  updatePauseButton();

  if (isPaused) {
    cancelAnimationFrame(animation);
    animation = null;
    stopMusic();
    pauseScreen.style.display = "flex";
  } else {
    pauseScreen.style.display = "none";
    lastTime = 0;
    if (musicOn) playMusic();
    animation = requestAnimationFrame(gameLoop);
  }
}

// ===== วาดภาพ =====

function drawBasket() {
  ctx.font = "65px sans-serif";
  ctx.textAlign = "center";
  ctx.fillText("🧺",basket.x+basket.w/2,basket.y+40);
}

function drawItems() {
  items.forEach(item => {
    if (item.type === "bomb") {
      ctx.save();
      ctx.font = "32px sans-serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText("💣", item.x, item.y);
      ctx.restore();
      return;
    }

    // วาดกล่องรองสินค้าให้ดูเหมือนกล่องผลิตภัณฑ์ที่กำลังตกลงมา
    const boxX = item.x - 27;
    const boxY = item.y - 33;
    const boxW = 54;
    const boxH = 66;
    const img = productImages[item.productIndex];

    ctx.save();
    ctx.shadowColor = "rgba(25, 55, 35, 0.28)";
    ctx.shadowBlur = 5;
    ctx.shadowOffsetY = 2;
    ctx.fillStyle = "#ffffff";
    ctx.strokeStyle = "#e3b92f";
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    if (typeof ctx.roundRect === "function") {
      ctx.roundRect(boxX, boxY, boxW, boxH, 7);
    } else {
      ctx.rect(boxX, boxY, boxW, boxH);
    }
    ctx.fill();
    ctx.stroke();
    ctx.restore();

    if (img && img.complete && img.naturalWidth > 0) {
      // ใช้ภาพแพ็กเกจสินค้าจริงทั้ง 7 แบบ แทนตัวหนังสือ
      ctx.drawImage(img, item.x - 23, item.y - 29, 46, 58);
    } else {
      ctx.save();
      ctx.fillStyle = "#287c43";
      ctx.font = "bold 10px sans-serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText("MSP", item.x, item.y);
      ctx.restore();
    }
  });
}

function drawGame() {
  ctx.clearRect(0,0,400,550);
  drawItems();
  drawBasket();

  ctx.fillStyle = "#83c95b";
  ctx.fillRect(0,535,400,15);
}

// ===== สร้างผลไม้และระเบิด =====

function spawnItem() {
  const isBomb = Math.random() < 0.28;
  const productIndex = Math.floor(Math.random()*products.length);
  const product = products[productIndex];
  items.push({
    ...(isBomb ? bombItem : product),
    type: isBomb ? "bomb" : "product",
    productIndex,
    x:35+Math.random()*330,
    y:-35,
    speed:isBomb ? 5+Math.random()*3.5 : 2+Math.random()*2.5
  });
}

function catchItem(item) {
  const caught =
    item.y > basket.y-15 &&
    item.y < basket.y+basket.h &&
    item.x > basket.x-5 &&
    item.x < basket.x+basket.w+5;

  if (!caught) return false;

  if (item.type === "bomb") {
    bombs++;
    bombSound();
    updateStats();

    if (bombs >= 3) endGame();
  } else {
    score += item.points;

    productCounts[item.productIndex]++;

    fruitSound();
    updateStats();
  }

  return true;
}

// ===== ลูปเกม =====

function gameLoop(timestamp) {
  if (!playing || isPaused) return;

  const delta = lastTime
    ? Math.min((timestamp-lastTime)/16.67,2)
    : 1;

  lastTime = timestamp;
  spawnTimer += delta;

  if (spawnTimer >= 38) {
    spawnItem();
    spawnTimer = 0;
  }

  items.forEach(item => item.y += item.speed*delta);

  const remaining = [];

  for (const item of items) {
    if (catchItem(item)) {
      if (!playing) break;
      continue;
    }

    if (item.y < 580) remaining.push(item);
  }

  items = remaining;
  drawGame();

  if (playing && !isPaused) {
    animation = requestAnimationFrame(gameLoop);
  }
}

// ===== ควบคุมมือถือ =====

function moveBasket(clientX) {
  const rect = canvas.getBoundingClientRect();
  if (!rect.width) return;

  const x = (clientX-rect.left)*(400/rect.width);

  basket.x = Math.max(
    0,
    Math.min(400-basket.w,x-basket.w/2)
  );
}

canvas.addEventListener("pointerdown",event => {
  if (!playing || isPaused) return;

  event.preventDefault();

  try {
    canvas.setPointerCapture(event.pointerId);
  } catch(error) {}

  moveBasket(event.clientX);
});

canvas.addEventListener("pointermove",event => {
  if (!playing || isPaused) return;
  if (event.pointerType === "mouse" && event.buttons === 0) return;

  event.preventDefault();
  moveBasket(event.clientX);
});

// ===== ควบคุมคีย์บอร์ด =====

document.addEventListener("keydown",event => {
  if (!playing || isPaused) return;

  if (event.key === "ArrowLeft") {
    event.preventDefault();
    basket.x -= 25;
  }

  if (event.key === "ArrowRight") {
    event.preventDefault();
    basket.x += 25;
  }

  basket.x = Math.max(0,Math.min(400-basket.w,basket.x));
});

// ===== เริ่มเกม =====

function startGame() {
  cancelAnimationFrame(animation);
  animation = null;
  stopMusic();

  initAudio();
  resetGame();

  playing = true;

  startScreen.style.display = "none";
  resultScreen.style.display = "none";
  pauseScreen.style.display = "none";
  gameStats.style.display = "flex";

  drawGame();

  if (musicOn) playMusic();

  animation = requestAnimationFrame(gameLoop);
}

// ===== จบเกมและสรุปเปอร์เซ็นต์ =====

function endGame() {
  if (!playing) return;

  playing = false;
  isPaused = false;

  cancelAnimationFrame(animation);
  animation = null;
  stopMusic();

  pauseScreen.style.display = "none";
  gameStats.style.display = "none";

  gameOverSound();

  const percent = getPercent();
  const reached = score >= TARGET_SCORE;

  // คำนวณคะแนนและเปอร์เซ็นต์แยกตามสินค้าแต่ละชนิด
  // เปอร์เซ็นต์คิดจากเป้าหมาย 500 คะแนนต่อสินค้า
  const productBreakdown = products.map((product, index) => {
    const count = productCounts[index] || 0;
    const productScore = count * product.points;
    const productPercent = (productScore / TARGET_SCORE) * 100;
    const earnsDiscount = productScore > TARGET_SCORE;

    return {
      ...product,
      count,
      productScore,
      productPercent,
      earnsDiscount
    };
  });

  // สินค้าแต่ละชนิดที่ทำคะแนนเกิน 500 ได้ส่วนลด 5 บาท
  const discountProducts = productBreakdown.filter(product => product.earnsDiscount);
  const totalDiscount = discountProducts.length * 5;

  resultScreen.style.display = "block";

  resultScreen.innerHTML = `
    <h2>💥 GAME OVER!</h2>
    <h2 style="color:#ed8b25">🏆 ${score} คะแนน</h2>

    <p class="percent">${percent}%</p>
    <p>ความคืบหน้าเป้าหมาย 3500 คะแนน</p>

    <div class="progressTrack">
      <div class="progressFill" style="width:${percent}%"></div>
    </div>

    <h3>
      ${reached
        ? "🎉 ยอดเยี่ยม! ทำเป้าหมายสำเร็จ"
        : "สู้ต่ออีกนิด เพื่อให้ถึง 100%!"}
    </h3>

    <hr>
    <h3>📊 คะแนนแยกตามสินค้า</h3>
    <p style="font-size:12px;color:#555">คิดเปอร์เซ็นต์เทียบเป้าหมาย 500 คะแนนต่อสินค้า</p>
    <div style="display:grid;gap:7px;text-align:left;margin:8px 0">
      ${productBreakdown.map(product => `
        <div style="background:#f4f8f5;border:1px solid #dce9df;border-radius:10px;padding:7px 9px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
            <strong style="font-size:13px">${product.thai}</strong>
            <strong style="font-size:13px;color:#147d4b">${product.productPercent.toFixed(1)}%</strong>
          </div>
          <div style="font-size:12px;color:#555;margin:3px 0">
            เก็บได้ ${product.count} ชิ้น · ${product.productScore} / 500 คะแนน
          </div>
          <div style="height:7px;background:#dfe8e2;border-radius:99px;overflow:hidden">
            <div style="height:100%;width:${Math.min(100, product.productPercent)}%;background:#31a66a;border-radius:99px"></div>
          </div>
          <div style="font-size:12px;font-weight:bold;margin-top:4px;color:${product.earnsDiscount ? '#087b43' : '#777'}">
            ${product.earnsDiscount ? '🎁 ได้ส่วนลด 20 บาท' : 'ยังไม่ได้รับส่วนลด (ต้องเกิน 500 คะแนน)'}
          </div>
        </div>
      `).join("")}
    </div>

    <div style="background:#fff3d9;border:1px solid #f4ce78;border-radius:12px;padding:9px;margin:8px 0">
      <strong>💰 สรุปส่วนลดทั้งหมด: ${totalDiscount} บาท</strong>
      <div style="font-size:12px;color:#76551a;margin-top:3px">
        ${discountProducts.length
          ? `สินค้าที่ได้ส่วนลด: ${discountProducts.map(product => product.thai).join(", ")}`
          : "ยังไม่มีสินค้าใดทำคะแนนเกิน 500 คะแนน"}
      </div>
    </div>

    <hr>
    <p>💣 ระเบิด: ${bombs}/3</p>
    <h3>🎉 สินค้าที่เก็บได้ทั้งหมด: ${productCounts.reduce((a,b)=>a+b,0)} ชิ้น</h3>

    <button onclick="startGame()">🔄 เล่นอีกครั้ง</button>
  `;
}

// ===== เริ่มต้น =====

resetGame();

startScreen.style.display = "flex";
resultScreen.style.display = "none";
gameStats.style.display = "none";
pauseScreen.style.display = "none";

soundBtn.textContent = musicOn
  ? "🔊 ปิดเสียง"
  : "🔇 เปิดเสียง";

</script>
</body>
</html>
